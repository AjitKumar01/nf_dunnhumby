# ---------------------------------------------------------------------------
# Everything regenerable from the raw dunnhumby CSVs, plus run artifacts.
# `src/run/prepare.sh` rebuilds all model inputs in ~35 minutes.
# ---------------------------------------------------------------------------

# Stage 1-2 outputs: cleaned transactions and price panels.
data/

# Stage 2-3 outputs: model input and the cached ragged index.  The two small
# auxiliary inputs the training flags reference ARE committed (see below), so a
# fresh clone can train without rerunning the co-purchase scans.
basket_input/*
!basket_input/v3_beta_target.npz
!basket_input/v3_phimask_lift30.npy
# The affinity partition IS the model's category structure (280 groups, not the
# default 188).  It is derived, but from a clustering that is not part of the
# pipeline, so it ships rather than being rebuilt.
!basket_input/items_affinity.parquet

# Checkpoints, logs and evaluation artifacts.
out/
out_arms/
codex_checked/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# stray evaluation output if a checkpoint is passed by bare name
src/**/*_downstream.json
